<%- include('includes/header.ejs') %>
    <body>
        <div class="container section">
        <div class="notification is-primary">
            <h1 class = "title">Validar Contraseña</h1>

            <form action="/autor/login" method="POST">
                    <div class="field">
                        <div class="control">
                            <input class="input" type="password" name="password" id="password" placeholder="Escribe tu contraseña" required>
                        </div>
                    </div>

                <div class = "field">
                    <div class = "control">
                        <input class="input" type="password" name="confirmar" id="confirmar" placeholder="Confirma tu contraseña" required>
                    </div>
                </div>

                <div class = "control">
                    <button class = "button is-dark" type="submit">Validar</button>
                </div>
            </form>
            <p id="mensaje"></p>
        </div>
        </div> 
    </body>
</html>
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>Validar Contraseña</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
        <link rel="stylesheet" href="/estilos.css">
    </head>
    <body>
        <h1>Validar Contraseña</h1>
        <form id = "formpassword">
        <input type="password" id="password" placeholder="Escribe tu contraseña" required>
        <input type="password" id="confirmar" placeholder="Confirma tu contraseña" required>
        <button type="submit">Validar</button>
      </form>
      <p id="mensaje"></p>
      <script src="/login.js"></script>
    </body>
</html>